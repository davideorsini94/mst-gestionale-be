# Esempio di configurazione: copialo in .env (o .env_local) e sostituisci i valori.
# In produzione (NODE_ENV=production) nessun file viene letto: le variabili arrivano dall'ambiente del container.
# I valori qui sotto sono finti: non usarli in produzione.

# App
APP_PORT=3000
APP_HOST=0.0.0.0
# indirizzo con cui gli utenti aprono l'app (link nell'email di recupero password)
APP_PUBLIC_URL=http://localhost:5199
ADMIN_EMAIL=admin@example.com
# documentazione API su /api e /api-json: sempre attiva in sviluppo, in produzione solo con true
SWAGGER_ENABLED=false
# origini ammesse per il CORS, separate da virgole. In produzione vuoto = CORS spento (UI e API sullo stesso
# indirizzo tramite nginx); in sviluppo vuoto = qualsiasi origine
CORS_ORIGIN=

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=cambiami
DB_DATABASE=mst_gestionale
DB_SYNCHRONIZE=false
DB_LOGGING=false
# solo per emergenze: avvia anche se lo schema del DB non coincide con le entità
ALLOW_SCHEMA_DRIFT=false

# JWT (genera con: openssl rand -base64 48). Vuoto = l'app non parte
JWT_SECRET=
TOKEN_DURATION=8h

# Cifratura dei dati sensibili: 32 byte in base64, diverse tra loro (genera con: openssl rand -base64 32).
# Non cambiarle mai dopo il primo avvio: senza le chiavi originali dati, file e backup non sono più leggibili.
# Vuote = l'app non parte (nessuna chiave di esempio, per non usarla per sbaglio)
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=

# MinIO
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=cambiami
MINIO_BUCKET=mst-files
# migrazione dei file all'avvio: true = completa anche con molti file mancanti (bucket da verificare prima!)
ALLOW_MISSING_FILES=false
# true = riesegue la migrazione dei file anche se risulta già fatta
FORCE_STORAGE_MIGRATION=false

# Backup da Impostazioni → Backup
# cartella dei backup (in Docker va montata come volume, altrimenti si perde a ogni aggiornamento)
BACKUP_DIR=./backups
# cartella di pg_dump/pg_restore se non sono nel PATH (vuoto = PATH e cartelle abituali)
PG_BIN_DIR=

# Reminder System
REMINDER_ENABLED=false
# espressione cron dell'invio (default: ogni giorno alle 8)
REMINDER_CRON=0 8 * * *
REMINDER_DAYS_VEHICLE_TAX=30
REMINDER_DAYS_VEHICLE_INSPECTION=30
REMINDER_DAYS_VEHICLE_INSURANCE=365
REMINDER_DAYS_MEDICAL_CERTIFICATE=30
REMINDER_DAYS_DRIVING_LICENSE=60
REMINDER_DAYS_SKI_INSTRUCTOR_LICENSE=60
REMINDER_DAYS_COACH_LICENSE=60
